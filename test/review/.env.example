# Copy to test/review/.env (git ignores it) and fill in.

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The reviewer, as OpenRouter names it: pick one at https://openrouter.ai/models
# (for GLM, search "z-ai"). Its context should hold the whole review: the
# script prints the rough size before it sends.
REVIEW_MODEL=
