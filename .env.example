# Copy to .env and fill in values, then `docker compose up -d --build`.

# Required. Signs/encrypts cookies and other secrets.
# Generate one with: openssl rand -base64 48
SECRET_KEY_BASE=

# The host PurpleFlow is served from (used to build URLs).
PHX_HOST=localhost

# The port PurpleFlow listens on, both on the host and in the container.
PORT=4000

# Only needed if you're pointing at your own Postgres instead of the
# bundled "db" service in docker-compose.yml. Format: ecto://USER:PASS@HOST/DB
# DATABASE_URL=

# Required. Encrypts every stored credential (set at /credentials).
# Generate one with: openssl rand -base64 32
PURPLEFLOW_SECRET_KEY=

# Required. Logs into the whole web UI, including /credentials.
PURPLEFLOW_ADMIN_USERNAME=
PURPLEFLOW_ADMIN_PASSWORD=

# Optional. The Code node runner's private network, shared only with the app.
# Change it only if the default collides with a network you already use.
# PURPLEFLOW_RUNNER_SUBNET=10.250.250.0/24
