# Copy to .env and fill in values, then `docker compose up -d --build`.

# Required. Signs/encrypts cookies and other secrets.
# Generate one with: openssl rand -base64 48
SECRET_KEY_BASE=

# The host PurpleFlow is served from (used to build URLs).
PHX_HOST=localhost

# The port PurpleFlow listens on, both on the host and in the container.
PORT=4000

# Only needed if you're pointing at your own Postgres instead of the
# bundled "db" service in docker-compose.yml. Format: ecto://USER:PASS@HOST/DB
# DATABASE_URL=

# Required. Encrypts every stored credential (set at /credentials).
# Generate one with: openssl rand -base64 32
PURPLEFLOW_SECRET_KEY=

# Required. The one sign-in for the whole site: workflows, files, and
# credentials. Changing the password signs everyone out. 3 failed sign-ins
# lock that address out for 4 hours; restarting the app lifts every lockout.
PURPLEFLOW_ADMIN_USERNAME=
PURPLEFLOW_ADMIN_PASSWORD=

# Set this if a reverse proxy (Cloudflare, nginx, Caddy) sits in front: the
# header it puts the visitor's address in, like cf-connecting-ip or
# x-forwarded-for. Without it, every visitor looks like the proxy, and one
# person's failed sign-ins lock everyone out. Only set it if the app can't
# be reached except through the proxy, or the header can be forged.
# PURPLEFLOW_CLIENT_IP_HEADER=

# Optional. The Code node runner's private network, shared only with the app.
# Change it only if the default collides with a network you already use.
# PURPLEFLOW_RUNNER_SUBNET=10.250.250.0/24

# Optional. The workflows folder on this machine. Make it a git repo
# (`git init`) before the first `docker compose up`.
# WORKFLOWS_PATH=./workflows

# Optional. Your user and group IDs (`id -u`, `id -g`), so files saved
# through the files service belong to you.
# PUID=1000
# PGID=1000

# Optional. For agents that edit workflows: with `Authorization: Bearer <token>`
# they can read and write the workflow files at /fs/ and read GET
# /api/workflows (what loaded, what didn't, and why). Nothing else: not the
# UI, not credentials. Unset, agents have no way in.
# Generate one with: openssl rand -hex 24
# PURPLEFLOW_AGENT_TOKEN=
